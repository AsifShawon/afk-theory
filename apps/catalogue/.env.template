# Public catalogue site. Copy to .env.local for local work.
# On the hosting provider, set the same variables in its build settings.

# Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy anon key.
# Safe for the build: row level security only exposes published products.
# Never put the secret / service_role key here.
SUPABASE_PUBLISHABLE_KEY=

# Public address of the site, used for share previews and the sitemap.
# e.g. https://afktheory.pages.dev or https://afktheory.com
NEXT_PUBLIC_SITE_URL=http://localhost:8100

# In `next dev`, pages read Supabase live so the admin's Preview shows changes
# immediately. Set to 0 to use the last synced data instead.
CATALOGUE_DEV_LIVE=1
