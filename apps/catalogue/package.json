{
  "name": "@dtc/catalogue",
  "version": "1.0.0",
  "private": true,
  "description": "AFK THEORY animated product showcase. Static export built from Supabase, orders through WhatsApp and Messenger.",
  "scripts": {
    "sync": "tsx scripts/sync-catalogue.ts",
    "dev": "tsx scripts/sync-catalogue.ts && next dev -p 8100",
    "build": "tsx scripts/sync-catalogue.ts && next build",
    "preview": "node scripts/serve-out.mjs",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "tsx src/lib/__tests__/order-message.test.ts"
  },
  "dependencies": {
    "@dtc/catalogue-core": "workspace:*",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.49.0",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0",
    "next": "15.5.21",
    "next-view-transitions": "^0.3.4",
    "react": "19.0.5",
    "react-dom": "19.0.5"
  },
  "devDependencies": {
    "@dtc/storefront-ui": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.4.8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.2"
  }
