# Medusa Backend Environment Variables (Local Development Example)
# Copy this file to .env for local development only. Never use these values in production.

# PostgreSQL database connection string (isolated for AFK THEORY)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/afk_theory_backend

# Redis connection string for caching and event bus
REDIS_URL=redis://localhost:6379

# CORS configurations
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:5173

# Security secrets for JWT token signing and session cookies
# IMPORTANT: In production, generate cryptographically random 32+ character strings using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=afk_theory_dev_jwt_secret_key_minimum_32_characters_long
COOKIE_SECRET=afk_theory_dev_cookie_secret_key_minimum_32_characters_long

# Backend URL
MEDUSA_BACKEND_URL=http://localhost:9000
