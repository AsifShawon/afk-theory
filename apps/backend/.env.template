# AFK THEORY Medusa Backend Environment Template
# Copy this file to .env and fill in required values for your target environment.

# CORS Settings (Restrict strictly to your storefront, admin, and mobile domains. Never include docs.medusajs.com in production.)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Cache and Event Bus
REDIS_URL=redis://localhost:6379

# Security Secrets
# GENERATE SECURE SECRETS: Run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# CRITICAL: In production, JWT_SECRET and COOKIE_SECRET MUST be distinct, at least 32 characters, and never shared or committed.
JWT_SECRET=replace_with_secure_random_32_char_hex_jwt_secret
COOKIE_SECRET=replace_with_secure_random_32_char_hex_cookie_secret

# Database
# Note: Use the isolated afk_theory_backend database to prevent collision with other projects.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/afk_theory_backend
DB_NAME=afk_theory_backend

# Stripe Payment Provider (Optional, disabled at launch for pure COD)
# Set ENABLE_STRIPE=true to activate Stripe in medusa-config.ts
ENABLE_STRIPE=false
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# Transactional Email Provider (Resend)
RESEND_API_KEY=re_placeholder_api_key_here
RESEND_FROM_EMAIL=AFK THEORY <orders@afktheory.com>
RESEND_REPLY_TO=support@afktheory.com

# Cloudflare R2 / S3-Compatible Object Storage
S3_URL=https://media.afktheory.com
S3_BUCKET=afk-theory-media
S3_REGION=auto
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=r2_placeholder_access_key
S3_SECRET_ACCESS_KEY=r2_placeholder_secret_key
