# Next.js Storefront Environment Variables (Local Development Example)
# Copy this file to .env.local for local development.

# Medusa Storefront Publishable API Key (Required for Store API)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Base URL of the storefront application
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region code for Bangladesh localization
NEXT_PUBLIC_DEFAULT_REGION=bd

# Disable search engine indexing (useful for staging / local dev)
NEXT_PUBLIC_INDEXING_DISABLED=false

# Stripe publishable key (optional, disabled at launch for Cash on Delivery)
# NEXT_PUBLIC_STRIPE_KEY=

# Node environment
NODE_ENV=development
