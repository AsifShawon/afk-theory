# AFK THEORY Next.js Storefront Environment Template
# Copy this file to .env.local and configure for your environment.

# Medusa Backend & Storefront URLs
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=bd
NODE_ENV=development

# Medusa Storefront Publishable API Key (Required)
# Obtained from Medusa Admin -> Settings -> Publishable API Keys, or generated during seed
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_placeholder_publishable_key

# Search Engine Indexing (Set to true in staging / preview environments to block crawlers via robots.txt)
NEXT_PUBLIC_INDEXING_DISABLED=false

# Stripe Publishable Key (Optional - disabled at launch for pure COD)
# NEXT_PUBLIC_STRIPE_KEY=pk_test_placeholder_key_here
