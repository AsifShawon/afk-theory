# LOCAL-ONLY admin. Copy to .env.local (gitignored). Never deploy this app.

# Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# Secret key (sb_secret_...) or the legacy service_role key.
# It bypasses all database security: keep it on this machine only.
SUPABASE_SECRET_KEY=

# Optional. Deploy hook URL from Cloudflare Pages / Netlify / Vercel.
# The admin's Publish button calls it to rebuild the public site.
CATALOGUE_DEPLOY_HOOK_URL=

# Where the Preview link points. Run `pnpm catalogue:dev` to use it.
CATALOGUE_PREVIEW_URL=http://localhost:8100

# ---- Orders (optional). Same values as the order endpoint on Cloudflare.
# Used by the Orders screen to email customers about status changes and to
# resend order emails that failed.
# Resend API key (re_...). Server only.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. AFK THEORY <orders@afktheory.com>
ORDER_EMAIL_FROM=
# Your inbox for order copies.
ORDER_NOTIFY_EMAIL=
# Public site address for links in emails, e.g. https://afktheory.com
CATALOGUE_SITE_URL=
